# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=cpbs-admin.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cpbs-admin
VITE_FIREBASE_STORAGE_BUCKET=cpbs-admin.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# YouTube API
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
VITE_YOUTUBE_ANDROID_API_KEY=your_youtube_android_api_key_here

# Content Delivery
VITE_GITHUB_CDN_URL=https://your-worker-url.workers.dev

# Web Push VAPID key — get from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# Cloudflare Tokens (DO NOT COMMIT ACTUAL KEYS)
# For local use only - DO NOT use VITE_ prefix for these to prevent client-side exposure!
CLOUDFLARE_EMAIL=your_email@example.com
CLOUDFLARE_USER_API_TOKEN=your_user_api_token_here
CLOUDFLARE_ACCOUNT_API_TOKEN=your_account_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
