<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════════
         API 27+ — Android 8.1 (Oreo MR1)
         Introduced: android:windowLightNavigationBar
         Now we can show DARK icons on our light navigation bar.
         This is important for devices with 3-button nav (back/home/overview).
         ═══════════════════════════════════════════════════════════════ -->

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:overScrollMode">never</item>
        <!-- Status bar: cream, dark icons -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Navigation bar: cream, dark icons (back/home/recents are now dark) -->
        <item name="android:navigationBarColor">@color/navigationBarColor</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
