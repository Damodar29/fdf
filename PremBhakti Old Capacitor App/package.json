{
	"name": "Prem Bhakti",
	"private": true,
	"version": "47.0.7",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:debug": "tsc && vite build --mode debug",
		"lint": "tsc --noEmit",
		"lint:biome": "biome check .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"cap:sync:android": "npx cap sync android",
		"ota:push": "node ota-predeploy.mjs && npm run build && node ota-push.mjs",
		"ota:push:only": "node ota-predeploy.mjs && node ota-push.mjs",
		"ps:push": "npm run build && npm run ps:push:only",
		"ps:push:only": "powershell -ExecutionPolicy Bypass -File .\\scripts\\play-store-deploy.ps1",
		"fonts:fetch": "node scripts/fetch-janmashtami-fonts.mjs",
		"fonts:check": "node scripts/fetch-janmashtami-fonts.mjs --check",
		"backup:data": "node scripts/backup-firebase-data.mjs",
		"test:family": "npm --prefix functions run build && firebase emulators:exec --project demo-family --only auth,firestore,functions \"node functions/test/familyLinks.emulator.cjs\"",
		"test:relations": "tsx scripts/check-relations.ts",
		"test:search": "tsx scripts/check-search.ts",
		"test:names": "tsx scripts/check-names.ts",
		"test:devotees": "tsx scripts/check-devotee-search.ts && tsx scripts/check-family-network.ts && tsx scripts/check-shared-family.ts && tsx scripts/check-profile-issues.ts && tsx scripts/check-relation-fixes.ts && tsx scripts/check-relation-questions.ts",
		"test:usage": "tsx scripts/check-usage-stats.ts",
		"test:rules": "firebase emulators:exec --project demo-family --only firestore,storage \"node functions/test/familyRules.emulator.cjs && node functions/test/userPrefsRules.emulator.cjs && node functions/test/lastSeenRules.emulator.cjs\"",
		"generate-icons": "tsx scripts/process_icons.ts",
		"setup-icon": "tsx scripts/icon-setup.ts",
		"postinstall": "npx patch-package && node scripts/sync-skills.mjs",
		"skills:sync": "node scripts/sync-skills.mjs",
		"ruflo:daemon": "npx ruflo daemon start",
		"ruflo:status": "npx ruflo status",
		"ruflo:doctor": "npx ruflo doctor --fix",
		"ruflo:audit": "npx ruflo security audit",
		"ruflo:all": "npm run ruflo:doctor && npm run ruflo:status && npm run ruflo:audit && npm run ruflo:daemon",
		"ruflo:task": "powershell -ExecutionPolicy Bypass -File .\\scripts\\ruflo-swarm.ps1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1075.0",
		"@aws-sdk/lib-storage": "^3.1075.0",
		"@capacitor-community/fcm": "^7.3.0",
		"@capacitor-community/keep-awake": "^6.0.0",
		"@capacitor-firebase/app-check": "^7.0.0",
		"@capacitor-firebase/authentication": "^7.5.0",
		"@capacitor/android": "^7.5.0",
		"@capacitor/app": "^7.1.2",
		"@capacitor/browser": "^7.0.0",
		"@capacitor/clipboard": "^8.0.1",
		"@capacitor/core": "^7.0.0",
		"@capacitor/device": "^7.0.5",
		"@capacitor/file-transfer": "^1.0.12",
		"@capacitor/filesystem": "^7.1.8",
		"@capacitor/haptics": "^7.0.0",
		"@capacitor/ios": "^7.6.2",
		"@capacitor/preferences": "^7.0.4",
		"@capacitor/push-notifications": "^7.0.3",
		"@capacitor/screen-orientation": "^7.0.0",
		"@capacitor/share": "^7.0.0",
		"@capacitor/splash-screen": "^7.0.5",
		"@capacitor/status-bar": "^7.0.0",
		"@capacitor/text-zoom": "^7.0.0",
		"@capawesome/capacitor-app-update": "^7.2.0",
		"@capgo/capacitor-media-session": "^7.3.0",
		"@capgo/capacitor-updater": "^8.50.1",
		"@claude-flow/aidefence": "^3.0.3",
		"@google/genai": "^1.44.0",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@types/dompurify": "^3.0.5",
		"@types/libsodium-wrappers": "^0.7.14",
		"agentic-flow": "^2.1.3",
		"archiver": "^8.0.0",
		"astronomy-engine": "^2.1.19",
		"capacitor-native-settings": "^7.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cors": "^2.8.6",
		"csv-parse": "^7.0.2",
		"csv-stringify": "^6.8.3",
		"date-fns": "^4.1.0",
		"dompurify": "^3.4.8",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"firebase": "^12.13.0",
		"firebase-admin": "^14.1.0",
		"firebase-functions": "^7.2.3",
		"framer-motion": "^13.1.1",
		"googleapis": "^174.0.1",
		"jose": "^6.1.3",
		"libsodium-wrappers": "^0.8.4",
		"lucide-react": "^0.475.0",
		"next-themes": "^0.4.6",
		"openai": "^6.48.0",
		"p-limit": "^7.3.0",
		"qrcode-generator": "^2.0.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"sonner": "^2.0.8",
		"sqlite3": "^6.0.1",
		"tailwind-merge": "^3.6.0",
		"tsx": "^4.21.0",
		"vaul": "^1.1.2",
		"zip-a-folder": "^6.1.1",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@capacitor/assets": "^3.0.0",
		"@capacitor/cli": "^7.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"basic-ftp": "^6.0.1",
		"glob": "^13.0.6",
		"postcss": "^8.4.47",
		"sharp": "^0.35.2",
		"tailwindcss": "^3.4.13",
		"terser": "^5.48.0",
		"typescript": "^5.7.3",
		"vite": "^6.4.1",
		"vite-plugin-dynamic-import": "^1.6.0",
		"vite-plugin-pwa": "^1.2.0",
		"vite-plugin-static-copy": "^2.2.0",
		"workbox-window": "^7.4.0"
	},
	"overrides": {
		"minimatch": "^10.2.1",
		"tar": "^7.5.7"
	}
}
