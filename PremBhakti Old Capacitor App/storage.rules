rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is an admin by querying Firestore
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.token.email.lower()));
    }


    function isMandalAdmin() {
      // Mandal admin data lives in admin_roles/{email}, not users/{uid}
      return request.auth != null && 
             request.auth.token.email != null &&
             firestore.get(/databases/(default)/documents/admin_roles/$(request.auth.token.email.lower())).data.role == 'mandal';
    }

    function callerMandalId() {
      // admin_roles doc uses 'mandalId' field (not 'mandalAdminFor')
      return firestore.get(/databases/(default)/documents/admin_roles/$(request.auth.token.email.lower())).data.mandalId;
    }

    function targetMandalId(userId) {
      let targetUser = firestore.get(/databases/(default)/documents/users/$(userId));
      return targetUser != null ? targetUser.data.mandalId : null;
    }
    
    // Allow users to upload their own profile photos, and allow admins/mandal_admins to edit them
    match /profile_photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
          userId == request.auth.uid || 
          isAdmin() ||
          (
             isMandalAdmin() && (
                 targetMandalId(userId) == callerMandalId() ||
                 (targetMandalId(userId) == null && userId.matches('^mc_.*'))
             )
          )
      );
    }
    
    // Retired: app 47.0.0/47.0.1 kept an automatic backup here. Backups now
    // live only in the devotee's Google Drive, so no new files may be written.
    // The owner can still delete theirs (account deletion does).
    match /user_backups/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
    }

    // App data JSON files (bhajans, books, lectures, appconfig)
    // Public reads so CDN Worker & end-users can fetch data.
    // Writes restricted to Admins only.
    match /app-data/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny access to everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
