+            if (appIconResId == 0) appIconResId = getApplicationInfo().icon;
+            
+            NotificationCompat.Builder placeholder = new NotificationCompat.Builder(this, CHANNEL_ID)
+                    .setSmallIcon(appIconResId)
+                    .setContentTitle("Prem Bhakti")
+                    .setContentText("Preparing audio\u2026")
+                    .setContentIntent(
