{
	"compilerOptions": {
		"target": "ES2022",
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"types": ["node", "vite/client"],
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"moduleDetection": "force",
		"allowJs": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./*"]
		},
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["**/*.ts", "**/*.tsx", "types.d.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"functions",
		"old stable",
		"mobile-app",
		"android",
		"b2-worker",
		"backup",
		"temp_videos",
		"temp_video",
		"test_dist",
		".wrangler",
		".firebase",
		"graphify-out",
		"reports",
		"scripts",
		".cursor",
		".gemini",
		".claude",
		".artifacts",
		".idea",
		"scratch",
		"ruflo",
		"data",
		"agent",
		".swarm",
		".claude-flow",
		".agents"
	]
}
