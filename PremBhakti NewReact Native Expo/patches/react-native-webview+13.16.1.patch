+package com.reactnativecommunity.webview;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Environment;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+
+import androidx.annotation.Nullable;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Prem Bhakti RN: serves the bundled Capacitor web build (android assets/web)
+ * at https://localhost/, the origin the Capacitor app used, so the old app's
+ * web storage and login are found by the WebView screens. Paths without a
+ * file extension get index.html (the web app is a single-page app).
+ *
+ * Files the web code saved on the device are shown through Capacitor's
+ * convertFileSrc URLs, https://localhost/_capacitor_file_/<absolute path>;
+ * those are read from the app's own folders or the shared storage only.
+ */
+public final class RNCLocalWebAssets {
+    private static final String HOST = "localhost";
+    private static final String ROOT = "web";
+    private static final String FILE_PREFIX = "/_capacitor_file_";
+    private static final Map<String, String> MIME = new HashMap<>();
+
+    static {
+        MIME.put("html", "text/html");
+        MIME.put("js", "application/javascript");
+        MIME.put("mjs", "application/javascript");
+        MIME.put("css", "text/css");
+        MIME.put("json", "application/json");
+        MIME.put("webmanifest", "application/manifest+json");
+        MIME.put("svg", "image/svg+xml");
+        MIME.put("png", "image/png");
+        MIME.put("jpg", "image/jpeg");
+        MIME.put("jpeg", "image/jpeg");
+        MIME.put("gif", "image/gif");
+        MIME.put("webp", "image/webp");
+        MIME.put("avif", "image/avif");
+        MIME.put("ico", "image/x-icon");
+        MIME.put("woff", "font/woff");
+        MIME.put("woff2", "font/woff2");
+        MIME.put("ttf", "font/ttf");
+        MIME.put("otf", "font/otf");
+        MIME.put("mp3", "audio/mpeg");
+        MIME.put("m4a", "audio/mp4");
+        MIME.put("wav", "audio/wav");
+        MIME.put("mp4", "video/mp4");
+        MIME.put("wasm", "application/wasm");
+        MIME.put("txt", "text/plain");
+        MIME.put("xml", "application/xml");
+        MIME.put("pdf", "application/pdf");
+    }
+
+    private RNCLocalWebAssets() {}
+
+    @Nullable
+    public static WebResourceResponse intercept(Context context, WebResourceRequest request) {
+        Uri url = request.getUrl();
+        if (url == null || !"https".equals(url.getScheme()) || !HOST.equals(url.getHost())) return null;
+        if (!"GET".equalsIgnoreCase(request.getMethod())) return null;
+
+        String path = url.getPath();
+        if (path != null && path.startsWith(FILE_PREFIX + "/")) return deviceFile(context, path.substring(FILE_PREFIX.length()));
+        if (path == null || path.isEmpty() || path.equals("/")) path = "/index.html";
+        String name = path.substring(path.lastIndexOf('/') + 1);
+        int dot = name.lastIndexOf('.');
+        if (dot < 0) path = "/index.html";
+        String ext = path.substring(path.lastIndexOf('.') + 1).toLowerCase();
+
+        try {
+            InputStream stream = context.getAssets().open(ROOT + path);
+            String mime = MIME.containsKey(ext) ? MIME.get(ext) : "application/octet-stream";
+            boolean text = mime.startsWith("text/") || mime.endsWith("javascript") || mime.endsWith("json");
+            WebResourceResponse response = new WebResourceResponse(mime, text ? "UTF-8" : null, stream);
+            Map<String, String> headers = new HashMap<>();
+            headers.put("Access-Control-Allow-Origin", "*");
+            headers.put("Cache-Control", "no-cache");
+            response.setResponseHeaders(headers);
+            return response;
+        } catch (IOException e) {
+            return notFound();
+        }
+    }
+
+    private static WebResourceResponse notFound() {
+        WebResourceResponse missing = new WebResourceResponse("text/plain", "UTF-8", null);
+        missing.setStatusCodeAndReasonPhrase(404, "Not Found");
+        return missing;
+    }
+
+    private static boolean isUnder(String path, @Nullable File root) {
+        if (root == null) return false;
+        try {
+            String base = root.getCanonicalPath();
+            return path.equals(base) || path.startsWith(base + File.separator);
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    private static WebResourceResponse deviceFile(Context context, String absolutePath) {
+        try {
+            File file = new File(absolutePath).getCanonicalFile();
+            String path = file.getPath();
+            File external = context.getExternalFilesDir(null);
+            boolean allowed = isUnder(path, new File(context.getApplicationInfo().dataDir))
+                || isUnder(path, external != null ? external.getParentFile() : null)
+                || isUnder(path, Environment.getExternalStorageDirectory());
+            if (!allowed || !file.isFile()) return notFound();
+            String ext = path.substring(path.lastIndexOf('.') + 1).toLowerCase();
+            String mime = MIME.containsKey(ext) ? MIME.get(ext) : "application/octet-stream";
+            WebResourceResponse response = new WebResourceResponse(mime, null, new FileInputStream(file));
+            Map<String, String> headers = new HashMap<>();
+            headers.put("Access-Control-Allow-Origin", "*");
+            response.setResponseHeaders(headers);
+            return response;
+        } catch (IOException | SecurityException e) {
+            return notFound();
+        }
+    }
+}
